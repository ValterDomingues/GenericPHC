# Database
DB_ENGINE=postgresql
# DB_ENGINE=mysql
# DB_ENGINE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password
# For sqlite only:
# DB_PATH=./data.db

# SMTP / email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true
EMAIL_FROM=noreply@example.com
EMAIL_TO=recipient@example.com
EMAIL_SUBJECT=Periodic database report

# Scheduler (used when running with --loop)
# Interval in minutes between sends
SEND_INTERVAL_MINUTES=60
